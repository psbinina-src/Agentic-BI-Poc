# Run the standard server only; never use dev-server/dev mode for normal use.
CUBEJS_DEV_MODE=false
CUBEJS_DB_TYPE=duckdb
CUBEJS_DB_DUCKDB_DATABASE_PATH=../../.local/agentic_bi.duckdb
CUBEJS_API_SECRET=replace-with-a-local-random-secret
CUBEJS_TELEMETRY=false
PORT=4000

# SQL API is disabled unless CUBEJS_PG_SQL_PORT is configured.
# Enable only in an ignored local .env, with unique local credentials:
# CUBEJS_PG_SQL_PORT=15432
# CUBEJS_SQL_USER=local_bi_user
# CUBEJS_SQL_PASSWORD=replace-with-a-local-random-password
